#!/usr/bin/env bash
# Usage: [EMULATOR_UNIT=app-emulator.service] scripts/emulator start|stop|status|wait
set -euo pipefail
source "$(dirname "$0")/env.sh"
unit="${EMULATOR_UNIT:-app-emulator.service}"

case "${1:-status}" in
  start)  systemctl --user start "$unit" ;;
  stop)   systemctl --user stop "$unit" ;;
  status) systemctl --user --no-pager status "$unit" | head -5; adb devices ;;
  wait)
    adb wait-for-device
    until [ "$(adb shell getprop sys.boot_completed | tr -d '\r')" = 1 ]; do sleep 2; done
    echo "emulator ready" ;;
  *) echo "usage: $0 start|stop|status|wait" >&2; exit 1 ;;
esac
